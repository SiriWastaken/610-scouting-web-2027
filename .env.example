# Copy to .env.local (never committed) and fill in. Every variable is described
# in docs/10-authentication.md; nothing here may be a real secret.

# ── Scouting data (Sync Gateway, read by the dashboard) ─────────────────────
COUCHBASE_SYNC_GATEWAY_URL=https://your-sync-gateway-host:4984
COUCHBASE_DATABASE=scoutingapp2026
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION=_default

# ── Sign-in ─────────────────────────────────────────────────────────────────
# The exact origin people use to open the dashboard (redirect URIs are built from it).
AUTH_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-openssl-rand-base64-48

# Sign in with Google, the only sign-in method (Google Cloud Console → Credentials → OAuth client ID, type "Web application").
# Anyone Google lets through this client is approved automatically; managers deny access afterwards in Admin → Users.
AUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Accounts, sessions, and the audit log: a SEPARATE Sync Gateway database (not the scouting one).
# It must exist before anyone signs in (docs/10-authentication.md, "The account store").
# AUTH_STORE_URL is optional: leave it commented out to use COUCHBASE_SYNC_GATEWAY_URL.
# AUTH_STORE_URL=https://other-sync-gateway-host:4984
AUTH_STORE_DATABASE=scouting_auth
# Development only: keep accounts in .data/auth-store.json instead (real Google sign-in still works).
# AUTH_STORE=local
# Or keep accounts in a collection (it may be in the scouting database), e.g. scope "app", collection "auth":
# AUTH_STORE_SCOPE=app
# AUTH_STORE_COLLECTION=auth
AUTH_STORE_USERNAME=dashboard-accounts
AUTH_STORE_PASSWORD=your-account-store-password

# The Owner: always has every permission and is the only one who manages mentors and changes names (comma-separated).
AUTH_OWNER_EMAILS=you@example.org
