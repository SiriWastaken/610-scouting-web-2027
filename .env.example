# Copy to .env.local (never committed) and fill in. Every variable is described
# in docs/authentication.md; nothing here may be a real secret.

# ── Scouting data (Sync Gateway, read by the dashboard) ─────────────────────
COUCHBASE_SYNC_GATEWAY_URL=https://your-sync-gateway-host:4984
COUCHBASE_DATABASE=scoutingapp2026
COUCHBASE_USERNAME=your-username
COUCHBASE_PASSWORD=your-password
COUCHBASE_SCOPE=_default
COUCHBASE_COLLECTION=_default

# ── Sign-in ─────────────────────────────────────────────────────────────────
# The exact origin people use to open the dashboard (redirect URIs are built from it).
AUTH_URL=http://localhost:3000
# At least 32 random characters: openssl rand -base64 48
AUTH_SECRET=replace-with-openssl-rand-base64-48

# Sign in with Google (Google Cloud Console → Credentials → OAuth client ID, type "Web application")
AUTH_GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
AUTH_GOOGLE_CLIENT_SECRET=your-google-client-secret

# Sign in with Apple (optional; all four are required to enable it)
AUTH_APPLE_CLIENT_ID=org.example.scouting.web
AUTH_APPLE_TEAM_ID=ABCDE12345
AUTH_APPLE_KEY_ID=FGHIJ67890
# The .p8 key's contents; literal \n line breaks are accepted
AUTH_APPLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----

# Accounts, sessions, and the audit log: a SEPARATE Sync Gateway database (not the scouting one)
AUTH_STORE_URL=https://your-sync-gateway-host:4984
AUTH_STORE_DATABASE=scouting_auth
AUTH_STORE_USERNAME=dashboard-accounts
AUTH_STORE_PASSWORD=your-account-store-password

# Emails that are always ROOT (comma-separated). Needed to bootstrap the first admin.
AUTH_ROOT_EMAILS=you@example.org
# Emails or @domains that are approved automatically on first sign-in; everyone else waits for approval.
AUTH_AUTO_APPROVE=@example.org
# Session lifetime (hours): absolute maximum and idle timeout. Defaults: 720 and 168.
AUTH_SESSION_MAX_AGE_HOURS=720
AUTH_SESSION_IDLE_HOURS=168
